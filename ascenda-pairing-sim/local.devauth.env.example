# Copy to local.devauth.env (gitignored) and fill from BE team DevAuth handoff.
# Development backend only (ASPNETCORE_ENVIRONMENT=Development).
# Do not commit local.devauth.env.
#
# Hosts:
#   http://localhost:5002
#   https://app-asc-dev-api-aue.azurewebsites.net
#
# Prerequisites (BE-owned): DevAuth Patient GUID must exist in Users with active
# consent leases (AiDataProcessing / ide_telemetry). Missing user → confirm 500;
# missing consent → ingest 403.

ASCENDA_API_BASE_URL=https://app-asc-dev-api-aue.azurewebsites.net
ASCENDA_DEVICE_ID=pairing-sim-console

# DevAuth user bearer (confirm / list / revoke) — not a real JWT
ASCENDA_USER_TOKEN=

# DevAuth admin bearer (metrics) — optional for this CLI
ASCENDA_ADMIN_TOKEN=
