# Local-only secrets / DevAuth tokens — never commit
.env
.env.*
!.env.example
local.devauth.env
**/local.devauth.env
*.local.env

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# Build / deps (package-level ignores also apply)
**/node_modules/
# And the same name as a SYMLINK. The line above ends in a slash, so it matches
# directories only: a `node_modules` symlink into another checkout is not
# ignored, gets committed unremarked, and then resolves to that checkout on
# anyone else's machine. It has cost two of them their real node_modules.
node_modules
**/dist/
**/out/
*.tsbuildinfo

# Release artifacts — built by CI on tag, never committed
*.vsix

# Local dev-server state + personal Claude Code hook wiring (scripts/setup-local.sh)
.ascenda/
.claude/settings.local.json
.claude/settings.local.json.ascenda-backup

# Local editor/agent instructions and personal working notes
CLAUDE.local.md
